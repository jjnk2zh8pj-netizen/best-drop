<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Best Drop</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        /* --- ВСЕ СТИЛИ ВНУТРИ --- */
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Tahoma, sans-serif; -webkit-tap-highlight-color: transparent; }
        body { background-color: #0a0a0c; color: #fff; padding-bottom: 80px; }
        .header { display: flex; justify-content: space-between; align-items: center; padding: 15px 20px; }
        .logo { font-size: 24px; font-weight: 900; font-style: italic; letter-spacing: 1px; }
        .logo span { color: #ff0000; margin-left: 5px; }
        .header-controls { display: flex; align-items: center; gap: 10px; }
        .balance-pill { background: #1a1a1f; border: 1px solid #333; padding: 6px 12px; border-radius: 20px; display: flex; align-items: center; gap: 8px; font-weight: bold; font-size: 14px; }
        .balance-pill .plus { background: #ff0000; width: 20px; height: 20px; display: flex; justify-content: center; align-items: center; border-radius: 50%; font-size: 14px; cursor: pointer; }
        .tg-status { background: #1a1a1f; border: 1px solid #333; padding: 6px 12px; border-radius: 20px; display: flex; align-items: center; gap: 6px; font-size: 12px; color: #aaa; }
        .tg-status .dot { color: #00ff00; }
        .avatar { width: 36px; height: 36px; border-radius: 50%; border: 2px solid #ff0000; object-fit: cover; }

        .banner { padding: 0 20px; margin-bottom: 25px; }
        .banner-inner { background: linear-gradient(90deg, #1a0000, #4a0000); border-radius: 20px; padding: 30px 20px; border: 1px solid #ff000033; display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
        .banner-title { font-size: 36px; font-weight: 900; font-style: italic; line-height: 1; }
        .banner-title span { color: #ff0000; }
        .banner-desc { font-size: 14px; color: #ccc; }
        .btn-main { background: #ff0000; color: white; border: none; padding: 12px 20px; border-radius: 10px; font-weight: bold; font-size: 14px; cursor: pointer; margin-top: 10px; }

        .section-header { display: flex; justify-content: space-between; align-items: center; padding: 0 20px; margin-bottom: 15px; }
        .section-title { font-size: 18px; font-weight: bold; }
        .btn-all { background: #1a1a1f; border: 1px solid #333; color: #fff; padding: 6px 12px; border-radius: 10px; cursor: pointer; font-size: 12px; }

        .cases-grid { display: grid; grid-template-columns: 1fr; gap: 15px; padding: 0 20px; margin-bottom: 25px; }
        @media(min-width: 600px) { .cases-grid { grid-template-columns: repeat(3, 1fr); } }
        .case-card { background: #111115; border: 1px solid #222; border-radius: 15px; overflow: hidden; }
        .case-img { width: 100%; height: 180px; object-fit: cover; background: #000; }
        .case-content { padding: 15px; text-align: center; display: flex; flex-direction: column; gap: 5px; }
        .case-name { font-size: 18px; font-weight: 900; }
        .case-sub { color: #888; font-size: 12px; }
        .case-price-row { display: flex; gap: 10px; margin-top: 10px; }
        .price-tag { background: #1a1a1f; border: 1px solid #333; border-radius: 10px; padding: 10px; display: flex; align-items: center; justify-content: center; font-weight: bold; flex: 1; font-size: 14px; }
        .btn-open { background: #ff0000; color: white; border: none; border-radius: 10px; padding: 10px; font-weight: bold; font-size: 14px; cursor: pointer; flex: 2; }

        .quick-links { display: grid; grid-template-columns: 1fr; gap: 10px; padding: 0 20px; margin-bottom: 25px; }
        @media(min-width: 600px) { .quick-links { grid-template-columns: repeat(3, 1fr); } }
        .quick-card { background: #111115; border: 1px solid #222; border-radius: 15px; padding: 15px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
        .quick-info h4 { font-size: 14px; margin-bottom: 2px; }
        .quick-info p { color: #666; font-size: 11px; }

        .bottom-nav { position: fixed; bottom: 0; left: 0; width: 100%; background: #111115; border-top: 1px solid #222; display: flex; justify-content: space-around; padding: 10px 0; z-index: 100; }
        .nav-item { display: flex; flex-direction: column; align-items: center; gap: 3px; color: #666; font-size: 10px; cursor: pointer; }
        .nav-item.active { color: #ff0000; }
        .nav-item span { font-size: 18px; }

        /* Стили рулетки */
        .modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 1000; display: flex; justify-content: center; align-items: center; flex-direction: column; }
        .modal.hidden { display: none; }
        .modal-content { width: 90%; max-width: 600px; text-align: center; }
        .roulette-container { position: relative; width: 100%; height: 120px; background: #111; border: 2px solid #333; border-radius: 10px; overflow: hidden; margin: 20px 0; box-shadow: inset 0 0 20px rgba(0,0,0,0.8); }
        .roulette-pointer { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 4px; height: 100%; background: #ff0000; z-index: 10; box-shadow: 0 0 10px #ff0000; }
        .roulette-strip { display: flex; height: 100%; position: absolute; left: 0; top: 0; transition: transform 5s cubic-bezier(0.15, 0.9, 0.2, 1); }
        .roulette-item { width: 100px; height: 100%; flex-shrink: 0; border-right: 1px solid #333; display: flex; justify-content: center; align-items: center; background: #1a1a1f; padding: 5px; flex-direction: column; font-size: 10px; text-align: center; }
        .roulette-item img { max-width: 80%; max-height: 80%; object-fit: contain; }
        .btn-main.hidden { display: none; }
    </style>
</head>
<body>
    <header class="header">
        <div class="logo">BEST<span>DROP</span></div>
        <div class="header-controls">
            <div class="balance-pill">
                <span>♦</span> 12 450 <div class="plus">+</div>
            </div>
            <div class="tg-status">
                <span>✈️</span> Telegram <span class="dot">●</span>
            </div>
            <img src="https://i.pravatar.cc/100?img=11" alt="avatar" class="avatar">
        </div>
    </header>

    <section class="banner">
        <div class="banner-inner">
            <div class="banner-title">BEST<br><span>DROP</span></div>
            <div class="banner-desc">Открывай кейсы —<br>получай крутые скины!</div>
            <button class="btn-main" onclick="openCase('Sandstone')">Открыть кейс ></button>
        </div>
    </section>

    <div class="section-header">
        <div class="section-title">📦 Наши кейсы</div>
        <button class="btn-all">Все кейсы ></button>
    </div>

    <section class="cases-grid">
        <div class="case-card">
            <img src="sandstone.jpg" alt="Sandstone" class="case-img" onerror="this.src='https://via.placeholder.com/300x200/333/fff?text=Sandstone'">
            <div class="case-content">
                <div class="case-name">SANDSTONE</div>
                <div class="case-sub">Песчаная коллекция</div>
                <div class="case-price-row">
                    <div class="price-tag">♦ 99</div>
                    <button class="btn-open" onclick="openCase('Sandstone')">Открыть</button>
                </div>
            </div>
        </div>

        <div class="case-card">
            <img src="breeze.jpg" alt="Breeze" class="case-img" onerror="this.src='https://via.placeholder.com/300x200/333/fff?text=Breeze'">
            <div class="case-content">
                <div class="case-name">BREEZE</div>
                <div class="case-sub">Тропическая коллекция</div>
                <div class="case-price-row">
                    <div class="price-tag">♦ 149</div>
                    <button class="btn-open" onclick="openCase('Breeze')">Открыть</button>
                </div>
            </div>
        </div>

        <div class="case-card">
            <img src="dune.jpg" alt="Dune" class="case-img" onerror="this.src='https://via.placeholder.com/300x200/333/fff?text=Dune'">
            <div class="case-content">
                <div class="case-name">DUNE</div>
                <div class="case-sub">Золотая коллекция</div>
                <div class="case-price-row">
                    <div class="price-tag">♦ 199</div>
                    <button class="btn-open" onclick="openCase('Dune')">Открыть</button>
                </div>
            </div>
        </div>
    </section>

    <section class="quick-links">
        <div class="quick-card">
            <div class="quick-info"><h4>Рулетка</h4><p>Испытай удачу!</p></div>
            <span>></span>
        </div>
        <div class="quick-card">
            <div class="quick-info"><h4>Инвентарь</h4><p>Твои скины</p></div>
            <span>></span>
        </div>
        <div class="quick-card">
            <div class="quick-info"><h4>Профиль</h4><p>Статистика и настройки</p></div>
            <span>></span>
        </div>
    </section>

    <nav class="bottom-nav">
        <div class="nav-item active"><span>🏠</span>Главная</div>
        <div class="nav-item"><span>📦</span>Кейсы</div>
        <div class="nav-item"><span>🎡</span>Рулетка</div>
        <div class="nav-item"><span>🎒</span>Инвентарь</div>
        <div class="nav-item"><span>👤</span>Профиль</div>
    </nav>

    <div id="roulette-modal" class="modal hidden">
        <div class="modal-content">
            <h2 id="roulette-title">Открытие кейса...</h2>
            <div class="roulette-container">
                <div class="roulette-pointer"></div>
                <div id="roulette-strip" class="roulette-strip"></div>
            </div>
            <button id="close-roulette" class="btn-main hidden" onclick="closeRoulette()">Забрать</button>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
