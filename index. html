<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Best Drop</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Tahoma, sans-serif; -webkit-tap-highlight-color: transparent; }
        body { background-color: #0a0a0c; color: #fff; padding-bottom: 80px; }
        
        /* Шапка */
        .header { display: flex; justify-content: space-between; align-items: center; padding: 15px 20px; }
        .logo { font-size: 24px; font-weight: 900; font-style: italic; letter-spacing: 1px; }
        .logo span { color: #ff0000; margin-left: 5px; }
        .header-controls { display: flex; align-items: center; gap: 10px; }
        .balance-pill { background: #1a1a1f; border: 1px solid #333; padding: 6px 12px; border-radius: 20px; display: flex; align-items: center; gap: 8px; font-weight: bold; font-size: 14px; }
        .balance-pill .plus { background: #ff0000; width: 20px; height: 20px; display: flex; justify-content: center; align-items: center; border-radius: 50%; font-size: 14px; cursor: pointer; }
        .tg-status { background: #1a1a1f; border: 1px solid #333; padding: 6px 12px; border-radius: 20px; display: flex; align-items: center; gap: 6px; font-size: 12px; color: #aaa; }
        .tg-status .dot { color: #00ff00; }
        .avatar { width: 36px; height: 36px; border-radius: 50%; border: 2px solid #ff0000; object-fit: cover; }

        /* Баннер */
        .banner { padding: 0 20px; margin-bottom: 25px; }
        .banner-inner { background: linear-gradient(90deg, #1a0000, #4a0000); border-radius: 20px; padding: 30px 20px; border: 1px solid #ff000033; display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
        .banner-title { font-size: 36px; font-weight: 900; font-style: italic; line-height: 1; }
        .banner-title span { color: #ff0000; }
        .banner-desc { font-size: 14px; color: #ccc; }
        .btn-main { background: #ff0000; color: white; border: none; padding: 12px 20px; border-radius: 10px; font-weight: bold; font-size: 14px; cursor: pointer; margin-top: 10px; }

        /* Кейсы */
        .section-header { display: flex; justify-content: space-between; align-items: center; padding: 0 20px; margin-bottom: 15px; }
        .section-title { font-size: 18px; font-weight: bold; }
        .cases-grid { display: grid; grid-template-columns: 1fr; gap: 15px; padding: 0 20px; margin-bottom: 25px; }
        @media(min-width: 600px) { .cases-grid { grid-template-columns: repeat(3, 1fr); } }
        .case-card { background: #111115; border: 1px solid #222; border-radius: 15px; overflow: hidden; }
        .case-img { width: 100%; height: 180px; object-fit: cover; background: #000; }
        .case-content { padding: 15px; text-align: center; display: flex; flex-direction: column; gap: 5px; }
        .case-name { font-size: 18px; font-weight: 900; }
        .case-price-row { display: flex; gap: 10px; margin-top: 10px; }
        .price-tag { background: #1a1a1f; border: 1px solid #333; border-radius: 10px; padding: 10px; display: flex; align-items: center; justify-content: center; font-weight: bold; flex: 1; font-size: 14px; }
        .btn-open { background: #ff0000; color: white; border: none; border-radius: 10px; padding: 10px; font-weight: bold; font-size: 14px; cursor: pointer; flex: 2; }

        /* Меню */
        .bottom-nav { position: fixed; bottom: 0; left: 0; width: 100%; background: #111115; border-top: 1px solid #222; display: flex; justify-content: space-around; padding: 10px 0; z-index: 100; }
        .nav-item { display: flex; flex-direction: column; align-items: center; gap: 3px; color: #666; font-size: 10px; cursor: pointer; }
        .nav-item.active { color: #ff0000; }
        .nav-item span { font-size: 18px; }

        /* Рулетка */
        .modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 1000; display: flex; justify-content: center; align-items: center; flex-direction: column; }
        .modal.hidden { display: none; }
        .modal-content { width: 90%; max-width: 600px; text-align: center; }
        .roulette-container { position: relative; width: 100%; height: 120px; background: #111; border: 2px solid #333; border-radius: 10px; overflow: hidden; margin: 20px 0; }
        .roulette-pointer { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 4px; height: 100%; background: #ff0000; z-index: 10; box-shadow: 0 0 10px #ff0000; }
        .roulette-strip { display: flex; height: 100%; position: absolute; left: 0; top: 0; transition: transform 5s cubic-bezier(0.15, 0.9, 0.2, 1); }
        .roulette-item { width: 100px; height: 100%; flex-shrink: 0; border-right: 1px solid #333; display: flex; justify-content: center; align-items: center; background: #1a1a1f; padding: 5px; flex-direction: column; font-size: 10px; }
        .roulette-item img { max-width: 80%; max-height: 80%; object-fit: contain; }
        .btn-main.hidden { display: none; }

        /* Инвентарь */
        .inventory-screen { display: none; padding: 20px; }
        .inventory-screen.active { display: block; }
        .inventory-title { font-size: 24px; font-weight: bold; margin-bottom: 20px; }
        .inventory-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; }
        .inv-item { background: #111115; border: 1px solid #333; border-radius: 10px; padding: 10px; text-align: center; display: flex; flex-direction: column; justify-content: space-between; }
        .inv-item img { width: 100%; height: 80px; object-fit: contain; margin-bottom: 10px; }
        .inv-item p { font-size: 12px; color: #ff0000; margin-bottom: 10px; }
        
        /* Кнопка продажи */
        .btn-sell { background: #222; color: #fff; border: 1px solid #444; border-radius: 5px; padding: 5px; font-size: 12px; cursor: pointer; transition: 0.2s; }
        .btn-sell:hover { background: #ff0000; border-color: #ff0000; }
    </style>
</head>
<body>
    <div id="main-screen">
        <header class="header">
            <div class="logo">BEST<span>DROP</span></div>
            <div class="header-controls">
                <!-- Баланс теперь с ID, чтобы мы могли его менять -->
                <div class="balance-pill"><span>♦</span> <span id="balance-display">100</span> <div class="plus">+</div></div>
                <div class="tg-status"><span>✈️</span> TG <span class="dot">●</span></div>
                <img src="https://i.pravatar.cc/100?img=11" alt="avatar" class="avatar">
            </div>
        </header>

        <section class="banner">
            <div class="banner-inner">
                <div class="banner-title">BEST<br><span>DROP</span></div>
                <div class="banner-desc">Открывай кейсы —<br>получай крутые скины!</div>
                <button class="btn-main" onclick="openCase('Sandstone')">Открыть кейс ></button>
            </div>
        </section>

        <div class="section-header"><div class="section-title">📦 Наши кейсы</div></div>

        <section class="cases-grid">
            <!-- Кейс 1 -->
            <div class="case-card">
                <img src="https://via.placeholder.com/300x180/222/fff?text=SANDSTONE" class="case-img">
                <div class="case-content">
                    <div class="case-name">SANDSTONE</div>
                    <div class="case-price-row">
                        <div class="price-tag">♦ 99</div>
                        <button class="btn-open" onclick="openCase('Sandstone', 99)">Открыть</button>
                    </div>
                </div>
            </div>
            <!-- Кейс 2 -->
            <div class="case-card">
                <img src="https://via.placeholder.com/300x180/222/fff?text=BREEZE" class="case-img">
                <div class="case-content">
                    <div class="case-name">BREEZE</div>
                    <div class="case-price-row">
                        <div class="price-tag">♦ 149</div>
                        <button class="btn-open" onclick="openCase('Breeze', 149)">Открыть</button>
                    </div>
                </div>
            </div>
            <!-- Кейс 3 -->
            <div class="case-card">
                <img src="https://via.placeholder.com/300x180/222/fff?text=DUNE" class="case-img">
                <div class="case-content">
                    <div class="case-name">DUNE</div>
                    <div class="case-price-row">
                        <div class="price-tag">♦ 199</div>
                        <button class="btn-open" onclick="openCase('Dune', 199)">Открыть</button>
                    </div>
                </div>
            </div>
        </section>
    </div>

    <!-- ЭКРАН ИНВЕНТАРЯ -->
    <div id="inventory-screen" class="inventory-screen">
        <div class="inventory-title">🎒 Твой Инвентарь</div>
        <div id="inventory-grid" class="inventory-grid">
            <p id="empty-inv-msg" style="color: #666; grid-column: span 2; text-align: center;">Тут пока пусто...</p>
        </div>
    </div>

    <nav class="bottom-nav">
        <div class="nav-item active" id="nav-main" onclick="switchTab('main')"><span>🏠</span>Главная</div>
        <div class="nav-item"><span>📦</span>Кейсы</div>
        <div class="nav-item"><span>🎡</span>Рулетка</div>
        <div class="nav-item" id="nav-inv" onclick="switchTab('inventory')"><span>🎒</span>Инвентарь</div>
        <div class="nav-item"><span>👤</span>Профиль</div>
    </nav>

    <!-- ОКНО РУЛЕТКИ -->
    <div id="roulette-modal" class="modal hidden">
        <div class="modal-content">
            <h2>Открытие кейса...</h2>
            <div class="roulette-container">
                <div class="roulette-pointer"></div>
                <div id="roulette-strip" class="roulette-strip"></div>
            </div>
            <button id="close-roulette" class="btn-main hidden" onclick="closeRoulette()">Забрать</button>
        </div>
    </div>

    <script>
        const tg = window.Telegram.WebApp;
        tg.expand(); 

        // --- ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ ---
        let balance = 100; // Стартовый баланс
        let inventory = [];
        let currentDrop = null;

        // Обновляем баланс на экране при запуске
        document.getElementById('balance-display').innerText = balance;

        const casesData = {
            "Sandstone": [
                { name: "P350", rarity: "Common", chance: 50, img: "https://cdn.cs.money/730/skins/weapon_p250_sand_dune_light.png", price: 12 },
                { name: "MP7", rarity: "Rare", chance: 40, img: "https://cdn.cs.money/730/skins/weapon_mp7_impire_light.png", price: 49 },
                { name: "AKR", rarity: "Legendary", chance: 9, img: "https://cdn.cs.money/730/skins/weapon_ak47_neon_rider_light.png", price: 149 },
                { name: "Агент", rarity: "Arcane", chance: 1, img: "https://cdn.cs.money/730/skins/weapon_m4a1_silence_hyper_beast_light.png", price: 1499 }
            ],
            "Breeze": [
                { name: "Paladin", rarity: "Arcane", chance: 0.1, img: "https://cdn.cs.money/730/skins/weapon_m4a1_silence_hyper_beast_light.png", price: 12500 },
                { name: "Medal", rarity: "Common", chance: 99.9, img: "https://cdn.cs.money/730/skins/weapon_glock_water_elemental_light.png", price: 19 }
            ],
            "Dune": [
                { name: "M4", rarity: "Rare", chance: 40, img: "https://cdn.cs.money/730/skins/weapon_m4a1_silence_hyper_beast_light.png", price: 35 },
                { name: "SPAS", rarity: "Rare", chance: 30, img: "https://cdn.cs.money/730/skins/weapon_sawedoff_the_bank_light.png", price: 60 },
                { name: "M40", rarity: "Epic", chance: 15, img: "https://cdn.cs.money/730/skins/weapon_awp_asiimov_light.png", price: 180 },
                { name: "Anubis", rarity: "Legendary", chance: 9, img: "https://cdn.cs.money/730/skins/weapon_m4a1_silence_hyper_beast_light.png", price: 750 },
                { name: "Jade AK", rarity: "Arcane", chance: 1.5, img: "https://cdn.cs.money/730/skins/weapon_ak47_neon_rider_light.png", price: 999 },
                { name: "Karambit", rarity: "Arcane", chance: 0.01, img: "https://cdn.cs.money/730/skins/weapon_knife_karambit_doppler_phase2_light.png", price: 28000 }
            ]
        };

        function getRandomDrop(caseName) {
            const items = casesData[caseName];
            let totalChance = items.reduce((sum, item) => sum + item.chance, 0);
            let randomNum = Math.random() * totalChance;
            let currentChanceSum = 0;
            for (let item of items) {
                currentChanceSum += item.chance;
                if (randomNum <= currentChanceSum) return item;
            }
            return items[0];
        }

        function openCase(caseName, casePrice) {
            // Проверка баланса
            if (balance < casePrice) {
                tg.showAlert("Недостаточно монет! Продай скины из инвентаря.");
                if (tg.HapticFeedback) tg.HapticFeedback.notificationOccurred('error');
                return;
            }

            // Списываем деньги
            balance -= casePrice;
            document.getElementById('balance-display').innerText = balance;

            if (tg.HapticFeedback) tg.HapticFeedback.impactOccurred('medium');
            
            currentDrop = getRandomDrop(caseName);
            
            const modal = document.getElementById('roulette-modal');
            const strip = document.getElementById('roulette-strip');
            const closeBtn = document.getElementById('close-roulette');
            
            modal.classList.remove('hidden');
            closeBtn.classList.add('hidden');
            strip.style.transition = 'none';
            strip.style.transform = 'translateX(0)';
            
            let stripHTML = '';
            const pool = casesData[caseName];
            
            for (let i = 0; i < 50; i++) {
                const randItem = pool[Math.floor(Math.random() * pool.length)];
                stripHTML += `<div class="roulette-item"><img src="${randItem.img}"><span>${randItem.price} ♦</span></div>`;
            }
            
            stripHTML += `<div class="roulette-item"><img src="${currentDrop.img}"><span style="color:#ff0000; font-weight:bold;">${currentDrop.price} ♦</span></div>`;
            
            strip.innerHTML = stripHTML;

            setTimeout(() => {
                const containerWidth = strip.parentElement.offsetWidth;
                const itemWidth = 100; 
                const scrollDistance = (50 * itemWidth) + (containerWidth / 2) - (itemWidth / 2);
                
                strip.style.transition = 'transform 5s cubic-bezier(0.15, 0.9, 0.2, 1)';
                strip.style.transform = `translateX(-${scrollDistance}px)`;
                
                setTimeout(() => {
                    closeBtn.classList.remove('hidden');
                    if (tg.HapticFeedback) tg.HapticFeedback.notificationOccurred('success');
                }, 5100);
            }, 100);
        }

        function closeRoulette() {
            document.getElementById('roulette-modal').classList.add('hidden');
            if (currentDrop) {
                inventory.push(currentDrop);
                currentDrop = null;
                updateInventoryUI();
            }
        }

        function switchTab(tab) {
            const mainScreen = document.getElementById('main-screen');
            const invScreen = document.getElementById('inventory-screen');
            const navMain = document.getElementById('nav-main');
            const navInv = document.getElementById('nav-inv');

            if (tab === 'main') {
                mainScreen.style.display = 'block';
                invScreen.classList.remove('active');
                navMain.classList.add('active');
                navInv.classList.remove('active');
            } else if (tab === 'inventory') {
                mainScreen.style.display = 'none';
                invScreen.classList.add('active');
                navMain.classList.remove('active');
                navInv.classList.add('active');
                updateInventoryUI();
            }
        }

        function updateInventoryUI() {
            const grid = document.getElementById('inventory-grid');
            grid.innerHTML = '';
            if (inventory.length === 0) {
                grid.innerHTML = '<p style="color: #666; grid-column: span 2; text-align: center;">Тут пока пусто...</p>';
                return;
            }
            
            inventory.forEach((item, index) => {
                grid.innerHTML += `
                    <div class="inv-item">
                        <img src="${item.img}">
                        <p>${item.name}</p>
                        <div style="color: #888; font-size: 11px; margin-bottom: 5px;">Цена: ♦ ${item.price}</div>
                        <button class="btn-sell" onclick="sellItem(${index})">Продать за ${item.price} ♦</button>
                    </div>
                `;
            });
        }

        // Функция продажи скина
        function sellItem(index) {
            const item = inventory[index];
            balance += item.price; // Начисляем деньги
            inventory.splice(index, 1); // Удаляем скин из инвентаря
            
            document.getElementById('balance-display').innerText = balance;
            updateInventoryUI(); // Обновляем сетку
            
            if (tg.HapticFeedback) tg.HapticFeedback.notificationOccurred('success');
        }
    </script>
</body>
</html>
