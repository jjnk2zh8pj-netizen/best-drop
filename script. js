// Функция выбора выпавшего скина (математика шансов)
function getRandomDrop(caseName) {
    const items = casesData[caseName];
    let totalChance = items.reduce((sum, item) => sum + item.chance, 0);
    let randomNum = Math.random() * totalChance;
    let currentChanceSum = 0;
    
    for (let item of items) {
        currentChanceSum += item.chance;
        if (randomNum <= currentChanceSum) {
            return item;
        }
    }
    return items[0];
}

// Главная функция открытия кейса (с анимацией рулетки)
function openCase(caseName) {
    if (tg.HapticFeedback) tg.HapticFeedback.impactOccurred('medium');

    // 1. Выбираем выпавший скин (рандом)
    const droppedItem = getRandomDrop(caseName);
    
    const modal = document.getElementById('roulette-modal');
    const strip = document.getElementById('roulette-strip');
    const closeBtn = document.getElementById('close-roulette');
    
    // 2. Показываем окно и скрываем кнопку "Забрать"
    modal.classList.remove('hidden');
    closeBtn.classList.add('hidden');
    strip.style.transition = 'none';
    strip.style.transform = 'translateX(0)';
    
    // 3. Генерируем ленту
    let stripHTML = '';
    const pool = casesData[caseName];
    
    // Добавляем 30 случайных скинов для красоты
    for (let i = 0; i < 30; i++) {
        const randItem = pool[Math.floor(Math.random() * pool.length)];
        const imgSrc = randItem.img || 'https://via.placeholder.com/100x100/333/fff?text=Skin';
        stripHTML += `<div class="roulette-item"><img src="${imgSrc}" alt="skin"><span>${randItem.price} ♦</span></div>`;
    }
    
    // Добавляем выпавший скин 31-м (он встанет ровно под стрелку)
    const winImgSrc = droppedItem.img || 'https://via.placeholder.com/100x100/ff0000/fff?text=WIN';
    stripHTML += `<div class="roulette-item" id="winning-item"><img src="${winImgSrc}" alt="win"><span style="color:#ff0000; font-weight:bold;">${droppedItem.price} ♦</span></div>`;
    
    strip.innerHTML = stripHTML;

    // 4. Запускаем анимацию
    setTimeout(() => {
        const containerWidth = strip.parentElement.offsetWidth;
        const itemWidth = 100; // Ширина одного элемента в CSS
        const randomOffset = Math.floor(Math.random() * 60) - 30; 
        
        // Сдвигаем ленту так, чтобы 31-й элемент оказался в центре
        const scrollDistance = (30 * itemWidth) + (containerWidth / 2) - (itemWidth / 2) + randomOffset;
        
        strip.style.transition = 'transform 5s cubic-bezier(0.15, 0.9, 0.2, 1)'; // 5 секунд прокрутки
        strip.style.transform = `translateX(-${scrollDistance}px)`;
        
        // Когда прокрутка закончится (через 5 сек), показываем кнопку "Забрать"
        setTimeout(() => {
            closeBtn.classList.remove('hidden');
            if (tg.HapticFeedback) tg.HapticFeedback.notificationOccurred('success');
        }, 5100);
    }, 100);
}

// Функция закрытия окна рулетки
function closeRoulette() {
    document.getElementById('roulette-modal').classList.add('hidden');
    // В будущем здесь мы будем добавлять скин в инвентарь
}

